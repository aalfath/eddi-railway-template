{
	admin off
	auto_https off
	persist_config off
	servers {
		trusted_proxies static 100.64.0.0/10 152.233.0.0/16 127.0.0.1/32
	}
	log {
		output stdout
		level WARN
	}
}

:{$PORT:8080} {
	# Open health path for Railway: answers 200 only when EDDI and MongoDB are ready.
	handle /healthz {
		rewrite * /q/health/ready
		reverse_proxy 127.0.0.1:7070
	}

	# Everything else (Manager UI, REST API, /mcp, /v1, chat) needs the generated login.
	handle {
		basic_auth {
			{$EDDI_USERNAME} {$EDDI_PASSWORD_HASH}
		}
		reverse_proxy 127.0.0.1:7070 {
			header_up -Authorization
			flush_interval -1
		}
	}
}
